{
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules"
	],
	"compilerOptions": {
		"declaration": true,
		"emitDecoratorMetadata": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"lib": [
			"ESNext"
		],
		"module": "Node16",
		"moduleResolution": "node16",
		"noImplicitAny": true,
		"outDir": "dist/",
		"rootDir": "src/",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2021",
		"types": [
			"node"
		]
	}
}